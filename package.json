{
  "name": "zunia-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zunialab/fonts": "^0.1.0",
    "@zunialab/sdk-react": "^0.1.0",
    "@zunialab/tokens": "^0.1.0",
    "@zunialab/ui": "^0.1.0",
    "bech32": "^2.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "//": "BOOTSTRAP: resolves the @zunialab/* semver ranges above to local paths until the npm scope is live. Delete this whole pnpm block once published. See zunia-ui/RELEASING.md.",
    "overrides": {
      "@zunialab/ui": "link:../zunia-ui/packages/ui",
      "@zunialab/tokens": "link:../zunia-ui/packages/tokens",
      "@zunialab/fonts": "link:../zunia-ui/packages/fonts",
      "@zunialab/sdk-react": "link:../zunia-sdk/packages/react",
      "@zunialab/sdk-web": "link:../zunia-sdk/packages/web",
      "@zunialab/sdk-core": "link:../zunia-sdk/packages/core"
    }
  }
}
