# Zunia dashboard — local / deploy secrets

# Upstream APIs (server-only — never expose to the browser)
INDEXER_URL=http://127.0.0.1:8787
BACKEND_URL=http://127.0.0.1:8788
INDEXER_API_KEY=

# WalletConnect Cloud (same project ID as mobile + extension)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Native Connect with Zunia (Zunia-native WS broker)
NEXT_PUBLIC_ZUNIA_CONNECT_API_BASE=http://127.0.0.1:8788

# Extension detects via window.zunia; optional deep link back to mobile
NEXT_PUBLIC_MOBILE_DEEP_LINK=zunia://wc
NEXT_PUBLIC_MOBILE_UNIVERSAL_LINK=https://zunialab.com/wc

# Web Push (VAPID public only in the browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- NFTs (CW721 / ICS721) -------------------------------------------------
# All optional. Every one of these is off until set, and the NFT screens say
# which key is missing rather than guessing a value.

# Known CW721 collections to probe, per chain. CosmWasm has no chain-wide
# "tokens by owner" index, so a wallet can only ask contracts it knows about.
#   chainId=addr,addr;chainId2=addr
ZUNIA_NFT_CONTRACTS=

# A real "contracts by owner" index, where a chain has one. The only discovery
# path that can ever report a complete list. GET {url}?chainId=&owner=
# answering {"contracts": ["addr", ...]}. https:// (or a loopback for local dev).
ZUNIA_NFT_INDEXER_URL=
ZUNIA_NFT_INDEXER_NAME=

# cw-ics721 bridge contract per chain. Cross-chain NFT transfer stays off
# without it: an NFT sent to a guessed address is escrowed by nothing.
#   chainId=addr;chainId2=addr
ZUNIA_ICS721_BRIDGES=
# ICS721 channels, directional. ICS721 does not use the transfer port, so these
# cannot be discovered — they are deployment data.
#   sourceChainId>destChainId=channel-N;...
ZUNIA_ICS721_CHANNELS=

# Gateways for ipfs:// and ar:// artwork. https only, comma separated. There is
# no default on purpose: a hardcoded gateway would send every user's holdings to
# one operator.
ZUNIA_NFT_IPFS_GATEWAYS=
ZUNIA_NFT_ARWEAVE_GATEWAYS=

# Explorer link templates, per chain. No default: linking a user's token to a
# guessed domain is a fabrication.
#   chainId=https://host/path/{contract}/{tokenId}
ZUNIA_NFT_EXPLORER=
#   chainId=https://host/tx/{hash}
ZUNIA_EXPLORER_TX=

# Operator override for a known gap: zunia-extension/scripts/generate-chain-
# catalog.mjs drops the registry's features[] array, so no row in
# src/data/chain-catalog.json declares "cosmwasm" and the NFT surface is off on
# every chain. Set to 1 and Zunia asks each chain directly instead of assuming.
# Delete this once the generator carries features[] through.
ZUNIA_NFT_ALLOW_UNKNOWN_FEATURES=
