# Zunia dashboard — local / deploy secrets

# Upstream APIs (server-only — never expose to the browser)
INDEXER_URL=http://127.0.0.1:8787
BACKEND_URL=http://127.0.0.1:8788
INDEXER_API_KEY=

# WalletConnect Cloud (same project ID as mobile + extension)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Extension detects via window.zunia; optional deep link back to mobile
NEXT_PUBLIC_MOBILE_DEEP_LINK=zunia://wc
NEXT_PUBLIC_MOBILE_UNIVERSAL_LINK=https://zuniawallet.com/wc

# Web Push (VAPID public only in the browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
